# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key for LLM inference (used starting Phase 3 — the agent).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Random seed for the incident simulator, so generated incidents are reproducible.
SIMULATOR_SEED=42
